{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "galena",
  "compatibility_date": "2026-09-15",
  // Worker de solo assets: no hay script, Cloudflare sirve ./dist tal cual.
  "assets": {
    "directory": "./dist"
  },
  // El Custom Domain se creó desde el dashboard (el token de wrangler no tiene
  // permisos de DNS). Queda anotado aquí para que un deploy futuro no lo pierda.
  "routes": [{ "pattern": "galena.agency", "custom_domain": true }],
  // Temporal: workers.dev sigue vivo mientras se limpia la caché DNS negativa.
  "workers_dev": true
}
