---
// Servicios principales: lista tipo acordeón con una especialidad abierta a
// la vez. La abierta es un bloque plata con su descripción y una figura de
// línea (excepción aprobada a "sin ilustraciones": geometría abstracta hecha
// a mano, en --ink) que se traza y se mueve mientras está abierta. Se abre
// con hover (mouse), toque (táctil) o foco (teclado); la isla de abajo solo
// cambia la clase is-active y aria-expanded. Todo el estilo está en
// global.css. Sin JS (<noscript>) se ven todas abiertas.
// Copy en borrador, pendiente de aprobación.
const services = [
  {
    name: 'Sitios web',
    text: 'Modernos, rápidos y con el estilo de tu marca. Pensados para que cada visita termine en un mensaje o una cita.',
    figure: 'site',
  },
  {
    name: 'Automatizaciones',
    text: 'Mensajes de WhatsApp y correos que se envían solos: confirmaciones, recordatorios de cita y seguimiento, sin que tu recepción escriba cada uno.',
    figure: 'flow',
  },
  {
    name: 'Gestión de pacientes',
    text: 'Todos tus pacientes y conversaciones en un solo lugar, con el historial de cada uno y en qué etapa va.',
    figure: 'venn',
  },
  {
    name: 'Agenda de citas',
    text: 'Tus pacientes reservan desde tu sitio en los horarios que tú defines, y tu calendario se actualiza solo.',
    figure: 'calendar',
  },
  {
    name: 'Chat en tu sitio',
    text: 'Un chat que puedes conectar a WhatsApp para responder desde un solo lugar. Y si lo necesitas, un chatbot con inteligencia artificial: incluido en el plan IA Total o como servicio adicional.',
    figure: 'chat',
  },
];
---

<section class="services" id="servicios" aria-labelledby="services-title">
  <div class="section-intro" data-reveal-group>
    <p class="eyebrow">Servicios</p>
    <h2 class="section-title" id="services-title">Nuestra especialidad</h2>
  </div>

  <!-- La lista va dentro de un <div> del grupo: la entrada anima la lista
       entera y los <li> conservan sus propias transiciones (Reveal las
       reemplazaría en los hijos directos). -->
  <div data-reveal-group>
  <ul class="svc">
    {
      services.map((service, i) => (
        <li class:list={['svc__item', { 'is-active': i === 0 }]}>
          <h3 class="svc__head">
            <button
              class="svc__btn"
              type="button"
              id={`svc-btn-${i}`}
              aria-controls={`svc-body-${i}`}
              aria-expanded={i === 0 ? 'true' : 'false'}
            >
              <span class="svc__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__name">{service.name}</span>
              <span class="svc__plus" aria-hidden="true" />
            </button>
          </h3>
          <div class="svc__body" id={`svc-body-${i}`}>
            <div class="svc__inner">
              <p class="svc__text">{service.text}</p>
            </div>
          </div>

          {/* pathLength="1" en cada trazo: el dibujo de entrada anima
              stroke-dashoffset de 1 a 0 sin medir longitudes. */}
          <svg class="service__figure" viewBox="0 0 200 200" aria-hidden="true">
            {service.figure === 'site' && (
                <>
                  <rect x="30" y="45" width="140" height="110" rx="6" pathLength="1" />
                  <path d="M30 65H170" pathLength="1" />
                  <circle cx="42" cy="55" r="3" pathLength="1" />
                  <circle cx="54" cy="55" r="3" pathLength="1" />
                  <g class="service__motion service__motion--float">
                    <rect x="44" y="79" width="52" height="62" rx="3" pathLength="1" />
                    <path d="M108 86H156M108 100H156M108 114H140" pathLength="1" />
                    <rect x="108" y="126" width="32" height="15" rx="7.5" pathLength="1" />
                  </g>
                </>
              )}
              {service.figure === 'flow' && (
                <>
                  <rect x="75" y="28" width="50" height="22" rx="11" pathLength="1" />
                  <path d="M100 50V70" pathLength="1" />
                  <path d="M100 70L122 92L100 114L78 92Z" pathLength="1" />
                  <path d="M78 92H50V128M122 92H150V128" pathLength="1" />
                  <path d="M46 123L50 128L54 123M146 123L150 128L154 123" pathLength="1" />
                  <rect x="28" y="128" width="44" height="28" rx="4" pathLength="1" />
                  <rect x="128" y="128" width="44" height="28" rx="4" pathLength="1" />
                  <circle class="service__motion service__motion--flow" cx="100" cy="50" r="3" />
                </>
              )}
              {service.figure === 'venn' && (
                <g class="service__motion service__motion--spin-slow">
                  <circle cx="100" cy="76" r="42" pathLength="1" />
                  <circle cx="78" cy="114" r="42" pathLength="1" />
                  <circle cx="122" cy="114" r="42" pathLength="1" />
                  <circle cx="100" cy="101" r="3" pathLength="1" />
                </g>
              )}
              {service.figure === 'calendar' && (
                <>
                  <rect x="40" y="45" width="120" height="110" rx="8" pathLength="1" />
                  <path d="M40 72H160" pathLength="1" />
                  <path d="M72 36V54M128 36V54" pathLength="1" />
                  <text class="service__date" x="146" y="142" text-anchor="end">12</text>
                </>
              )}
              {service.figure === 'chat' && (
                <>
                  {/* Globo del bot arriba y el de los tres puntos abajo, sin
                      tocarse: ni los bordes ni las colas se cruzan (el de
                      abajo flota ±4px y queda espacio de sobra). */}
                  <rect x="30" y="28" width="100" height="52" rx="16" pathLength="1" />
                  <path d="M52 80L46 94L68 80" pathLength="1" />
                  {/* Cabeza de bot en el globo de arriba: el que responde. */}
                  <rect x="64" y="46" width="32" height="22" rx="6" pathLength="1" />
                  <path d="M80 46V39" pathLength="1" />
                  <circle cx="80" cy="37" r="2" pathLength="1" />
                  <g class="service__motion service__motion--blink">
                    <circle class="service__dot" cx="73" cy="57" r="2.5" />
                    <circle class="service__dot" cx="87" cy="57" r="2.5" />
                  </g>
                  <g class="service__motion service__motion--float">
                    <rect x="70" y="108" width="100" height="52" rx="16" pathLength="1" />
                    <path d="M148 160L154 174L132 160" pathLength="1" />
                    <circle cx="104" cy="134" r="3" pathLength="1" />
                    <circle cx="120" cy="134" r="3" pathLength="1" />
                    <circle cx="136" cy="134" r="3" pathLength="1" />
                  </g>
                </>
              )}
              
          </svg>
        </li>
      ))
    }
  </ul>
  </div>

  <!-- Sin JS no hay forma de abrir una fila: se muestran todas abiertas. -->
  <noscript>
    <style>
      .svc__item { background-color: var(--silver); border-radius: var(--space-3); margin-block: var(--space-1); border-bottom-color: transparent; }
      .svc__btn { grid-template-columns: minmax(0, 1fr); cursor: default; color: var(--ink); }
      .svc__plus { display: none; }
      .svc__body { grid-template-rows: 1fr; visibility: visible; }
      .service__figure { display: block; }
      .service__figure * { stroke-dashoffset: 0; }
      .service__figure :is(.service__date, .service__motion--flow, .service__dot) { opacity: 1; }
    </style>
  </noscript>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.services');
  const list = section?.querySelector<HTMLElement>('.svc');

  if (section && list) {
    const items = [...list.querySelectorAll<HTMLElement>('.svc__item')];
    let intent = 0;

    const activate = (index: number) => {
      items.forEach((item, i) => {
        const on = i === index;
        item.classList.toggle('is-active', on);
        item.querySelector('.svc__btn')?.setAttribute('aria-expanded', String(on));
      });
    };

    items.forEach((item, i) => {
      const button = item.querySelector<HTMLElement>('.svc__btn');
      // Toque, Enter/Espacio y foco (Tab) abren la fila.
      button?.addEventListener('click', () => {
        // En táctil la fila de arriba se cierra al abrir esta: el contenido
        // se movería bajo el dedo. Durante la transición se compensa el
        // scroll para que la fila tocada se quede donde está.
        const top = button.getBoundingClientRect().top;
        activate(i);
        const until = performance.now() + 600;
        const hold = () => {
          const delta = button.getBoundingClientRect().top - top;
          if (Math.abs(delta) > 0.5) scrollBy(0, delta);
          if (performance.now() < until) requestAnimationFrame(hold);
        };
        requestAnimationFrame(hold);
      });
      // Solo el foco de teclado abre la fila (un toque o un clic ya la abren
      // con su propio evento); así Tab no reacomoda la página sin querer.
      button?.addEventListener('focus', () => {
        if (button.matches(':focus-visible')) activate(i);
      });
      // Con mouse se abre al pasar, con una pausa corta para no abrir filas
      // de paso. Con la fila abierta, la lista no se mueve bajo el puntero
      // (todas miden lo mismo abiertas).
      item.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse') return;
        clearTimeout(intent);
        intent = window.setTimeout(() => activate(i), 70);
      });
      item.addEventListener('pointerleave', () => clearTimeout(intent));
    });

    // Las líneas de la primera figura se dibujan la primera vez que la
    // lista se ve.
    const seen = () => section.setAttribute('data-seen', '');
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry], observer) => {
        if (!entry.isIntersecting) return;
        seen();
        observer.disconnect();
      }, { threshold: 0.25 }).observe(list);
    } else {
      seen();
    }

    // En táctil la figura abierta se mueve mientras la sección está en
    // pantalla (no hay hover que la active).
    if (matchMedia('(hover: none)').matches && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        section.toggleAttribute('data-onscreen', entry.isIntersecting);
      }).observe(section);
    }
  }
</script>
