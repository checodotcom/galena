---
// Cabecera, header, footer y el diálogo de contacto compartidos por todas las
// páginas. Cada página solo aporta su <title>/<description> y el contenido
// de <main> vía slot.
import '../styles/global.css';
import ContactDialog from '../components/ContactDialog.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e4dfd6" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/urbanist-200.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Galena" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logotipo de Galena sobre fondo hueso" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Prefetch declarativo: es JSON, el navegador no ejecuta JS. -->
    <script is:inline type="speculationrules">
      {
        "prefetch": [
          {
            "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/api/*" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>

  <body>
    <header class="site-header">
      <a class="site-header__home" href="/" aria-label="Galena, inicio">
        <img
          class="site-header__logo"
          src="/galena-logo-negro.svg"
          alt="Galena"
          width="159"
          height="22"
        />
      </a>

      <button class="contact" type="button" commandfor="contact-dialog" command="show-modal">
        Contact
      </button>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <a class="site-footer__email" href="mailto:hola@galena.agency">hola@galena.agency</a>
      <p class="site-footer__legal">© {year} Galena</p>
    </footer>

    <ContactDialog />
  </body>
</html>
