---
import Layout from '../layouts/Layout.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import Reveal from '../components/Reveal.astro';
import Services from '../components/Services.astro';
import Audience from '../components/Audience.astro';
import ClosingCta from '../components/ClosingCta.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';

const title = 'Galena — Agencia digital';
const description =
  'Sitio web, automatizaciones y agentes para optimizar las conversiones de tu negocio.';

// Persianas de la transición hueso → plata. El CSS usa 15 en móvil y 10 en
// desktop; se renderizan todas y las sobrantes se ocultan por breakpoint.
const blinds = 15;
---

<Layout title={title} description={description}>
  <div class="intro" data-header-tone="clear">
    <!-- Antes que las persianas en el DOM: las barras la tapan al cerrarse. -->
    <svg class="intro__hint" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 9l6 6 6-6"></path>
    </svg>

    <div class="blinds" aria-hidden="true">
      {Array.from({ length: blinds }, (_, i) => <span style={`--i: ${i}`} />)}
    </div>
  </div>

  <section class="hero" data-header-tone="silver">
    <div class="hero__content">
      <h1 class="hero__title">Tu negocio, atendiendo aunque no estés.</h1>
      <p class="hero__support">
        Sitio web, automatizaciones y agentes que responden, agendan y dan
        seguimiento a tus clientes por ti.
      </p>
      <div class="hero__actions">
        <a class="plan-cta plan-cta--filled hero__cta" href="#servicios">
          <span class="hero__cta-inner">
            <span class="hero__cta-label">Explora nuestros servicios</span>
            <span class="hero__cta-arrow" aria-hidden="true">→</span>
          </span>
        </a>
        <a class="text-link hero__secondary" href="/planes/">Ver planes y precios →</a>
      </div>
    </div>

    <!-- Composición geométrica: las líneas parten la zona derecha en cuatro
         bloques, alternados como tablero (hueso arriba a la derecha y abajo a
         la izquierda). El círculo rebota dentro del bloque de abajo. -->
    <div class="hero__art" aria-hidden="true">
      <span class="hero__block hero__block--top"></span>
      <span class="hero__block hero__block--bottom">
        <span class="hero__orbit"><span class="hero__dot"></span></span>
      </span>
      <span class="hero__vline"></span>
      <span class="hero__hline"></span>
    </div>

    <svg class="hero__hint" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </section>

  <Services />

  <Audience />

  <ProcessTimeline />

  <ClosingCta />

  <About />

  <Faq />

  <Reveal />
</Layout>
