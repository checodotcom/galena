---
// Diálogo de contacto. Abrir y cerrar es HTML de la plataforma: el botón
// CONTACTO del header usa commandfor="contact-dialog" command="show-modal", y
// closedby="any" lo cierra al dar clic afuera. La isla (el <script> de abajo)
// envía el formulario, muestra los errores junto a cada campo y cambia
// estados. Sin JS, la validación nativa sigue funcionando.
import ConsentField from './ConsentField.astro';
// Mismo patrón que EMAIL_PATTERN en worker/index.js: sin él, el navegador
// acepta "juan@gmail" y el servidor lo rechaza con un error genérico.
const EMAIL_PATTERN = '[^\\s@<>"]+@[^\\s@<>"]+\\.[^\\s@<>"]+';
---

<dialog
  id="contact-dialog"
  class="contact-dialog"
  aria-labelledby="contact-dialog-title"
  closedby="any"
  data-lenis-prevent
>
  <form class="contact-form contact-form--line" action="/api/contact" method="post" data-state="idle">
    <button
      class="contact-dialog__close"
      type="button"
      commandfor="contact-dialog"
      command="close"
      aria-label="Cerrar"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>

    <h2 class="section-title contact-dialog__title" id="contact-dialog-title">Hablemos</h2>

    <fieldset class="contact-form__fields">
      <div class="field">
        <label class="sr-only" for="contact-name">Nombre</label>
        <input
          class="field__input"
          id="contact-name"
          name="name"
          autocomplete="name"
          maxlength="120"
          placeholder="Tu nombre"
          aria-describedby="contact-name-error"
          autofocus
          required
        />
        <p class="field__error" id="contact-name-error">Escribe tu nombre.</p>
      </div>

      <div class="field">
        <label class="sr-only" for="contact-email">Correo</label>
        <input
          class="field__input"
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          pattern={EMAIL_PATTERN}
          maxlength="200"
          placeholder="Tu correo"
          aria-describedby="contact-email-error"
          required
        />
        <p class="field__error" id="contact-email-error">Escribe un correo válido.</p>
      </div>

      <div class="field">
        <label class="sr-only" for="contact-company">Empresa (opcional)</label>
        <input
          class="field__input"
          id="contact-company"
          name="company"
          autocomplete="organization"
          maxlength="120"
          placeholder="Tu empresa"
        />
      </div>

      <div class="field">
        <label class="sr-only" for="contact-plan">Plan</label>
        <div class="select-wrap">
          <select class="field__input" id="contact-plan" name="plan">
            <option value="">Plan: por definir</option>
            <option value="01">01 Sitio Inteligente</option>
            <option value="02">02 Crecimiento</option>
            <option value="03">03 IA Total</option>
          </select>
          <svg class="select-wrap__chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </div>
      </div>

      <div class="field field--full">
        <label class="sr-only" for="contact-message">Mensaje</label>
        <textarea
          class="field__input"
          id="contact-message"
          name="message"
          rows="3"
          maxlength="5000"
          placeholder="Platícanos tu idea"
          aria-describedby="contact-message-error"
          required></textarea>
        <p class="field__error" id="contact-message-error">Escribe tu mensaje.</p>
      </div>

      <!-- Campo trampa para bots: fuera de pantalla y fuera del orden de tabulación. -->
      <label class="field--trap" aria-hidden="true">
        No llenar
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
    </fieldset>

    <!-- Aviso de privacidad y Enviar en la misma fila, como en /contacto. -->
    <div class="contact-form__footer">
      <ConsentField id="dialog-privacy" />
      <p class="contact-form__status" role="status"></p>
      <button class="send" type="submit">
        <span class="send__label">Enviar</span>
        <span class="send__spinner" aria-hidden="true"></span>
        <svg class="send__check" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1"></path>
        </svg>
      </button>
    </div>
  </form>
</dialog>

<script>
  import { enhanceContactForm } from '../scripts/contact-form.js';

  const dialog = document.getElementById('contact-dialog');
  const form = dialog.querySelector('.contact-form');
  const planField = form.querySelector('#contact-plan');
  const { reset, clearError } = enhanceContactForm(form);

  // Safari en iOS solo aplica :active si la página escucha touchstart. Sin esto,
  // CONTACT y ENVIAR no cambiarían de color al tocarlos.
  document.addEventListener('touchstart', () => {}, { passive: true });

  // El botón "Quiero este plan" de cada tarjeta trae data-plan y lo
  // preselecciona. El resto (CONTACTO del header, "Escríbenos") no toca el
  // plan: si ya había uno elegido junto con lo escrito, se conserva.
  const applyPlanFromSource = (source) => {
    if (source?.dataset.plan) planField.value = source.dataset.plan;
  };

  // Invoker Commands API: el diálogo recibe este evento antes de abrirse.
  dialog.addEventListener('command', (event) => {
    if (event.command === 'show-modal') applyPlanFromSource(event.source);
  });

  // Respaldo para navegadores sin commandfor (Safari < 26.2, Firefox < 144).
  // Cubre todos los <dialog> del sitio (contacto y menú): este script carga
  // en todas las páginas.
  if (!('commandForElement' in HTMLButtonElement.prototype)) {
    document.addEventListener('click', (event) => {
      const button = event.target.closest('button[commandfor]');
      const target = button && document.getElementById(button.getAttribute('commandfor'));
      if (!(target instanceof HTMLDialogElement)) return;
      if (button.getAttribute('command') === 'show-modal') {
        if (target === dialog) applyPlanFromSource(button);
        target.showModal();
      }
      if (button.getAttribute('command') === 'close') target.close();
    });
  }

  // Respaldo de closedby="any" (Safari aún no lo soporta) para todos los
  // <dialog> del sitio que lo piden (contacto y menú): un clic en el fondo
  // oscurecido llega al propio <dialog>, pero también uno en su padding;
  // solo se cierra si el clic cayó fuera de la caja.
  if (!('closedBy' in HTMLDialogElement.prototype)) {
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLDialogElement) || !target.open) return;
      if (target.getAttribute('closedby') !== 'any') return;
      const box = target.getBoundingClientRect();
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom;
      if (!inside) target.close();
    });
  }

  // Tras un envío exitoso, cerrar deja el formulario listo para otro
  // mensaje. Si falló, se quita el error pero se conserva lo escrito.
  dialog.addEventListener('close', () => {
    if (form.dataset.state === 'sent') reset();
    else clearError();
  });
</script>
