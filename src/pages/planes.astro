---
// Sección "Columnas": tabla de precios de 3 planes con periodo mensual/anual.
// El toggle es HTML+CSS puro (radios + :has()), sin isla ni JavaScript: ver
// "Islas para componentes interactivos" en CLAUDE.md.
import Layout from '../layouts/Layout.astro';

const title = 'Planes y precios — Galena';
const description =
  'Elige el plan de Galena para tu clínica: sitio web, agenda, recordatorios y reseñas. Sin contratos forzosos, sin cargos escondidos.';

// Precios en pesos mexicanos, sin IVA. Anual = 10 mensualidades (2 de descuento).
const mxn = (amount: number) => `$${new Intl.NumberFormat('es-MX').format(amount)}`;

const plans = [
  {
    index: '01',
    name: 'Sitio Inteligente',
    tagline: 'Para empezar a captar en línea',
    monthly: 2697,
    annual: 26970,
    savings: 5394,
    setup: 6197,
    cta: 'Quiero este plan',
    featured: false,
    includesLabel: 'Incluye',
    includes: [
      'Sitio web profesional (hasta 3 páginas)',
      'Dominio, hosting y mantenimiento',
      'Formularios con seguimiento automático',
      'Chat en el sitio conectado a WhatsApp Business (incluido)',
      'Bandeja única de mensajes',
    ],
  },
  {
    index: '02',
    name: 'Crecimiento',
    tagline: 'Para llenar la agenda y subir reseñas',
    monthly: 5897,
    annual: 58970,
    savings: 11794,
    setup: 9997,
    cta: 'Quiero este plan →',
    featured: true,
    badge: 'Recomendado',
    includesLabel: 'Todo lo de Sitio Inteligente, más',
    includes: [
      'Hasta 5 páginas en tu sitio web',
      'Sistema de reservas propio con recordatorios',
      'Manejo de reputación en Google',
      'Automatizaciones y seguimiento a pacientes',
      'Reporte mensual de resultados',
    ],
  },
  {
    index: '03',
    name: 'IA Total',
    tagline: 'Para atender 24/7 sin contratar',
    monthly: 9697,
    annual: 96970,
    savings: 19394,
    setup: 15697,
    cta: 'Quiero este plan',
    featured: false,
    includesLabel: 'Todo lo de Crecimiento, más',
    includes: [
      'Chatbot con IA en WhatsApp, Instagram, Facebook y sitio web',
      'Rescate de llamadas perdidas',
      'Respuesta a reseñas con IA',
      'Campañas por WhatsApp a tu base de pacientes',
      'Soporte prioritario y optimización mensual',
    ],
  },
];
---

<Layout title={title} description={description}>
  <div class="pricing-page">
    <div class="pricing-page__intro">
      <p class="eyebrow">Planes y modalidades</p>
      <h1 class="pricing-page__title">
        Elige el plan para tu <br class="pricing-page__title-break" />clínica
      </h1>
      <p class="pricing-page__lede">
        Sin contratos forzosos. Sin cargos escondidos. Sube de plan cuando quieras.
      </p>
    </div>

    <section class="pricing">
      <div class="pricing__toggle">
        <div class="period">
          <span class="period__label">Mensual</span>
          <label class="period__switch">
            <input type="checkbox" id="period-annual" role="switch" aria-label="Periodo anual" />
            <span class="period__track" aria-hidden="true"></span>
          </label>
          <span class="period__label">Anual</span>
        </div>
        <div class="period__notes">
          <p class="period__note">Recibe 2 mensualidades de descuento en la modalidad anual</p>
          <p class="period__note">La primera mensualidad empieza 30 días después de la implementación.</p>
        </div>
      </div>

      <div class="plans">
        {
          plans.map((plan) => (
            <article class:list={['plan', { 'plan--featured': plan.featured }]}>
              <div class="plan__head">
                {plan.badge ? (
                  <div class="plan__head-top">
                    <span class="plan__index">{plan.index}</span>
                    <span class="plan__badge">{plan.badge}</span>
                  </div>
                ) : (
                  <span class="plan__index">{plan.index}</span>
                )}
                <h2 class="plan__name">{plan.name}</h2>
                <p class="plan__tagline">{plan.tagline}</p>
              </div>

              <div class="plan__pricing">
                <p class="plan__price">
                  <span class="plan__amount plan__amount--monthly">{mxn(plan.monthly)}</span>
                  <span class="plan__amount plan__amount--annual">{mxn(plan.annual)}</span>
                  <span class="plan__unit plan__unit--monthly">MXN / mes + IVA</span>
                  <span class="plan__unit plan__unit--annual">MXN / año + IVA</span>
                </p>
                <p class="plan__savings">Ahorras {mxn(plan.savings)} MXN al año</p>
                <p class="plan__setup">
                  Implementación única: <span class="plan__setup-amount">{mxn(plan.setup)} MXN + IVA</span>
                </p>
              </div>

              <button
                type="button"
                class:list={['plan-cta', { 'plan-cta--filled': plan.featured }]}
                data-plan={plan.index}
                commandfor="contact-dialog"
                command="show-modal"
              >
                {plan.cta}
              </button>

              <div class="plan__includes">
                <p class="plan__includes-label">{plan.includesLabel}</p>
                <ul class="plan__list">
                  {plan.includes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <p class="pricing-page__note">
      Precios en pesos mexicanos. No incluyen IVA (16 %). Sin contratos forzosos ni cargos escondidos. <span class="pricing-page__note-glue">¿Necesitas algo a la medida? <button type="button" class="text-link" commandfor="contact-dialog" command="show-modal">Escríbenos →</button></span>
    </p>
  </div>
</Layout>
