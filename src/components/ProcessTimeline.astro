---
// Timeline de proceso. El avance (línea que se llena, pasos que se encienden)
// es CSS ligado al scroll, sin JS. La entrada de los textos la hace la isla
// Reveal.astro, a través de los data-reveal-group.
const steps = [
  {
    name: 'Descubrimiento',
    text: 'Conocemos tu clínica, a tus pacientes y lo que hoy te frena. Una sesión de arranque define qué vamos a construir y cómo sabremos que funciona.',
  },
  {
    name: 'Estrategia',
    text: 'Convertimos lo que aprendimos en un plan: estructura del sitio, mensajes, embudos y automatizaciones, con prioridades claras.',
  },
  {
    name: 'Diseño',
    text: 'Damos forma a la experiencia: lenguaje visual, pantallas y los detalles que hacen que tus pacientes entiendan y agenden.',
  },
  {
    name: 'Desarrollo',
    text: 'Construimos el sitio y conectamos todo: formularios, gestión de pacientes, WhatsApp y agentes de IA, probado en cada dispositivo.',
  },
  {
    name: 'Lanzamiento',
    text: 'Revisamos cada detalle y publicamos. Recibes los accesos y todo lo necesario para operar desde el primer día.',
  },
  {
    name: 'Acompañamiento',
    text: 'Después del lanzamiento seguimos contigo: medimos resultados y ajustamos lo que haga falta para que siga funcionando.',
  },
];
---

<section class="process" aria-labelledby="process-title">
  <div class="section-intro" data-reveal-group>
    <p class="eyebrow">Proceso</p>
    <h2 class="section-title" id="process-title">Cómo trabajamos</h2>
  </div>

  <ol class="process__steps">
    {
      steps.map((step, i) => (
        <li class="step">
          <span class="step__marker" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {i < steps.length - 1 && <span class="step__line" aria-hidden="true" />}
          <div class="step__body" data-reveal-group>
            <h3 class="step__name">{step.name}</h3>
            <p class="step__text">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
