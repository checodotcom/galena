---
// Cabecera, header, footer y el diálogo de contacto compartidos por todas las
// páginas. Cada página solo aporta su <title>/<description> y el contenido
// de <main> vía slot.
import '../styles/global.css';
import ContactDialog from '../components/ContactDialog.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import HeaderTone from '../components/HeaderTone.astro';
import Cursor from '../components/Cursor.astro';
import CookieNotice from '../components/CookieNotice.astro';
import SiteMenu from '../components/SiteMenu.astro';

interface Props {
  title: string;
  description: string;
  // Para páginas aún vacías: que los buscadores no las indexen.
  noindex?: boolean;
  // Datos estructurados (schema.org) de la página, si los tiene.
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#e4dfd6" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/urbanist-200.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Galena" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logotipo de Galena sobre fondo hueso" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Prefetch declarativo: es JSON, el navegador no ejecuta JS. -->
    <script is:inline type="speculationrules">
      {
        "prefetch": [
          {
            "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/api/*" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- Google Tag Manager (GTM-PBQSJZBJ), solo en producción. Todas las
         etiquetas (GA4 incluida) se administran desde GTM. La cola
         (dataLayer) se arma de inmediato, pero gtm.js se descarga hasta que
         la página terminó de cargar: no compite con el render ni con el LCP.
         Si en GTM se agregan rastreadores nuevos, actualizar /privacidad. -->
    {
      import.meta.env.PROD && (
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          addEventListener(
            'load',
            () => {
              const tag = document.createElement('script');
              tag.async = true;
              tag.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PBQSJZBJ';
              document.head.append(tag);
            },
            { once: true },
          );
        </script>
      )
    }
  </head>

  <body>
    {
      import.meta.env.PROD && (
        <noscript>
          <iframe
            src="https://www.googletagmanager.com/ns.html?id=GTM-PBQSJZBJ"
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"></iframe>
        </noscript>
      )
    }
    <header class="site-header">
      <a class="site-header__home" href="/" aria-label="Galena, inicio">
        <img
          class="site-header__logo"
          src="/galena-logo-negro.svg"
          alt="Galena"
          width="159"
          height="22"
        />
        <!-- Versión hueso del logo para el header sobre fondo tinta (escena
             "Por qué Galena" del zoom): se funde con la tinta al cambiar el
             tono. Decorativa: el nombre accesible es el de la otra. -->
        <img
          class="site-header__logo site-header__logo--bone"
          src="/galena-logo-hueso.svg"
          alt=""
          aria-hidden="true"
          width="159"
          height="22"
        />
      </a>

      <div class="site-header__actions">
        <!-- Círculo con flecha que, con el mouse o el foco, se estira y muestra
             "Cotizar". El texto siempre está en el DOM (nombre accesible). -->
        <button class="contact" type="button" commandfor="contact-dialog" command="show-modal">
          <span class="contact__label">Cotizar</span>
          <svg class="contact__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17L17 7M8 7h9v9"></path>
          </svg>
        </button>
        <button
          class="menu-button"
          type="button"
          commandfor="site-menu"
          command="show-modal"
          aria-label="Abrir menú"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9h14M5 15h14"></path></svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer" data-header-tone="silver">
      <a class="site-footer__email" href="mailto:hola@galena.agency">hola@galena.agency</a>
      <p class="site-footer__legal">© {year} Galena</p>
    </footer>

    <SiteMenu current={Astro.url.pathname} />
    <ContactDialog />
    <SmoothScroll />
    <HeaderTone />
    <Cursor />
    <CookieNotice />
  </body>
</html>
