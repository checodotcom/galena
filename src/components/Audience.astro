---
// Para quién es: una frase, sin lista de giros, y a la derecha (en desktop)
// el botón a /planes. Copy en borrador, pendiente de aprobación.
---

<section class="audience" aria-labelledby="audience-title">
  <div class="section-intro" data-reveal-group>
    <p class="eyebrow">Para quién</p>
    <h2 class="section-title" id="audience-title">
      Para cualquier negocio que quiera atender mejor.
    </h2>
  </div>

  <!-- El botón va dentro de un <div>: la entrada anima el <div> y el botón
       conserva su propia transición. -->
  <div class="audience__aside" data-reveal-group>
    <div>
      <!-- Píldora con el texto y círculo aparte con la flecha: al pasar el
           mouse, las dos cambian de color y la flecha sale por arriba a la
           derecha mientras entra otra desde abajo a la izquierda. -->
      <a class="cta-split" href="/planes/">
        <span class="cta-split__label">Conoce nuestros planes</span>
        <span class="cta-split__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9"></path></svg>
          <svg viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9"></path></svg>
        </span>
      </a>
    </div>
  </div>
</section>
