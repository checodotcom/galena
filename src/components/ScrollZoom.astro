---
// Escenas con zoom al hacer scroll (Hero → Por qué Galena → Para quién), en
// móvil y en escritorio: desde 560px de alto y sin movimiento reducido. Es
// una isla de la home: el scroll no baja el contenido, avanza una cámara.
//
// - La pista (.zoom) solo da recorrido de scroll; el escenario (.zoom__stage)
//   es sticky y las tres secciones van apiladas dentro.
// - El JS convierte el scroll en un progreso 0→1 (suavizado con lerp) y
//   escribe transform y opacity de cada escena; la coreografía vive aquí.
// - Cruce 1: el círculo negro del hero se agranda hasta llenar la pantalla y
//   se vuelve el fondo tinta de "Por qué Galena". Cruce 2: la sección tinta
//   se encoge en un círculo hacia la cifra "10" y deja ver debajo "Para
//   quién" en hueso.
// - Sin JS, con movimiento reducido o en pantallas muy bajas (móvil en
//   horizontal) las tres son secciones normales, una tras otra. Todo el
//   contenido está siempre en el DOM.
---

<!-- Antes de pintar la pista: decide si el CSS de escenas aplica (misma
     consulta que la del script de abajo), para que no haya salto de layout. -->
<script is:inline>
  if (matchMedia('(min-height: 560px) and (prefers-reduced-motion: no-preference)').matches) {
    document.documentElement.dataset.zoom = '';
  }
</script>

<script>
  const QUERY = '(min-height: 560px) and (prefers-reduced-motion: no-preference)';
  // Tramos del progreso (0→1 sobre toda la pista).
  // El primer cruce arranca justo al fijarse el escenario (sin tramo muerto
  // al llegar al final del hero) y las mesetas son cortas: el movimiento no
  // se detiene.
  // Al final queda solo un respiro corto (3%): al soltarse el escenario,
  // "Para quién" sube con el scroll normal, así que una meseta larga ahí era
  // scroll en el que no pasaba nada.
  const T1 = [0, 0.418]; // Hero → Por qué Galena
  const T2 = [0.55, 0.967]; // Por qué Galena → Para quién
  const HOLD = { hero: 0, why: 0.484, audience: 0.985 }; // centro de cada meseta
  // Lerp por cuadro a 60fps (menor = más inercia). En táctil el scroll del
  // dedo ya trae su propia inercia: se sigue más de cerca para no sentirlo
  // flotante.
  const EASE = matchMedia('(hover: none)').matches ? 0.3 : 0.085;

  const root = document.documentElement;
  const track = document.querySelector<HTMLElement>('.zoom');
  const stage = track?.querySelector<HTMLElement>('.zoom__stage');
  const hero = stage?.querySelector<HTMLElement>('.hero');
  const why = stage?.querySelector<HTMLElement>('.why');
  const audience = stage?.querySelector<HTMLElement>('.audience');
  const portalInk = stage?.querySelector<HTMLElement>('.zoom__portal--ink');
  const bgInk = stage?.querySelector<HTMLElement>('.zoom__bg--ink');
  const bgBone = stage?.querySelector<HTMLElement>('.zoom__bg--bone');
  const dot = hero?.querySelector<HTMLElement>('.hero__dot');
  // El foco del segundo cruce es la cifra enorme: la tinta se encoge hacia ella.
  const focal = why?.querySelectorAll<HTMLElement>('.why__item')[0]?.querySelector<HTMLElement>('.why__value');
  const header = document.querySelector<HTMLElement>('.site-header');
  // Al final del segundo cruce la tinta se guarda en una "o" del titular de
  // Para quién.
  const audienceTitle = audience?.querySelector<HTMLElement>('.section-title');

  if (track && stage && hero && why && audience && portalInk && bgInk && bgBone && dot && focal && header) {
    const mq = matchMedia(QUERY);
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const map = (v: number, a: number, b: number, c: number, d: number) => c + (d - c) * clamp((v - a) / (b - a));
    // Entra y sale suave (smoothstep): arranque y llegada sin tirones.
    const soft = (t: number) => t * t * (3 - 2 * t);
    const mapSoft = (v: number, a: number, b: number, c: number, d: number) =>
      c + (d - c) * soft(clamp((v - a) / (b - a)));

    let running = false;
    let raf = 0;
    let current = 0;
    let target = 0;
    let max = 1;
    let last = 0;
    let zoomed = false;
    let tone = '';
    let S1 = 40;
    let dotD = 64;
    let need1 = 1000; // radio con el que el círculo del hero cubre el header
    let need2 = 1000; // radio con el que el círculo que se encoge aún cubre el header
    let R2 = 1000; // radio con el que ese círculo cubre todo el escenario
    let nest = { cx: 0, cy: 0, r: 0 }; // la "o" donde se guarda la tinta
    let resizeTimer = 0;
    let lastW = 0;
    let lastH = 0;

    // Escala con la que un círculo de diámetro d, centrado en (cx, cy), cubre
    // todo el escenario (la esquina más lejana manda).
    const coverScale = (cx: number, cy: number, d: number) => {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      const far = Math.max(Math.hypot(cx, cy), Math.hypot(w - cx, cy), Math.hypot(cx, h - cy), Math.hypot(w - cx, h - cy));
      return (far / (d / 2)) * 1.05;
    };

    // Radio que cubre toda la franja del header (la esquina más lejana manda).
    const stripNeed = (cx: number, cy: number) => {
      const w = stage.clientWidth;
      const h = header.offsetHeight;
      return Math.hypot(Math.max(cx, w - cx), Math.max(cy, Math.abs(cy - h)));
    };

    // Centro de un elemento en coordenadas del escenario, sin transform
    // (las escenas se miden en reposo).
    const centerOf = (el: HTMLElement, scene: HTMLElement) => {
      const prev = scene.style.transform;
      scene.style.transform = 'none';
      const s = stage.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      scene.style.transform = prev;
      return { cx: r.left - s.left + r.width / 2, cy: r.top - s.top + r.height / 2, d: r.width };
    };

    // Círculo del hero: se mide con la animación ya en pausa (la clase
    // is-zoomed la detiene), así el portal nace exactamente donde está.
    // Los portales son capas del tamaño del escenario recortadas con un
    // círculo (clip-path): el borde queda nítido a cualquier tamaño. Escalar
    // un círculo pequeño lo dejaba borroso en el teléfono.
    let ink = { cx: 0, cy: 0 };
    let bone = { cx: 0, cy: 0 };
    const circle = (r: number, c: { cx: number; cy: number }) =>
      `circle(${Math.max(0, r).toFixed(1)}px at ${c.cx.toFixed(1)}px ${c.cy.toFixed(1)}px)`;

    const measureDot = () => {
      const { cx, cy, d } = centerOf(dot, hero);
      ink = { cx, cy };
      hero.style.transformOrigin = `${cx}px ${cy}px`;
      S1 = coverScale(cx, cy, d);
      dotD = d;
      need1 = stripNeed(cx, cy);
    };

    const measureFocal = () => {
      const { cx, cy } = centerOf(focal, why);
      bone = { cx, cy };
      why.style.transformOrigin = `${cx}px ${cy}px`;
      R2 = (coverScale(cx, cy, 2) * 2) / 2; // radio (no escala) que cubre todo
      need2 = stripNeed(cx, cy);
    };

    // Busca la "o" del titular de Para quién más cercana al "10" y mide su
    // centro y el radio de su hueco. Las letras se miden con Range, y la
    // altura de la "o" con canvas (la caja del texto incluye ascendentes).
    const measureNest = () => {
      if (!audienceTitle) return;
      const prev = audience.style.transform;
      audience.style.transform = 'none';
      const s = stage.getBoundingClientRect();
      const cs = getComputedStyle(audienceTitle);
      // El titular puede seguir desplazado por Reveal: se descuenta.
      const shift = new DOMMatrix(cs.transform === 'none' ? undefined : cs.transform);
      const size = parseFloat(cs.fontSize);
      const ctx = document.createElement('canvas').getContext('2d');
      if (!ctx) {
        audience.style.transform = prev;
        return;
      }
      ctx.font = `${cs.fontWeight} ${size}px ${cs.fontFamily}`;
      const m = ctx.measureText('o');
      const asc = m.actualBoundingBoxAscent;
      const desc = m.actualBoundingBoxDescent;
      const outer = Math.min(asc + desc, m.actualBoundingBoxLeft + m.actualBoundingBoxRight) / 2;
      const walker = document.createTreeWalker(audienceTitle, NodeFilter.SHOW_TEXT);
      let best: { cx: number; cy: number } | null = null;
      let bestDist = Infinity;
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        const text = node.textContent ?? '';
        for (let i = 0; i < text.length; i++) {
          if (text[i] !== 'o' && text[i] !== 'O') continue;
          const range = document.createRange();
          range.setStart(node, i);
          range.setEnd(node, i + 1);
          const r = range.getBoundingClientRect();
          // Centro de la tinta de la letra, no de su caja de avance.
          const cx = r.left - s.left - shift.m41 + (m.actualBoundingBoxRight - m.actualBoundingBoxLeft) / 2;
          // La línea base queda a "ascent de fuente" bajo el borde de la caja.
          const cy = r.top - s.top - shift.m42 + (m.fontBoundingBoxAscent ?? asc) - (asc - desc) / 2;
          const dist = Math.hypot(cx - bone.cx, cy - bone.cy);
          if (dist < bestDist) {
            bestDist = dist;
            best = { cx, cy };
          }
        }
      }
      audience.style.transform = prev;
      // Menos el grosor del trazo (peso 200): el círculo entra en el hueco.
      if (best) nest = { ...best, r: Math.max(2, outer - size * 0.045) };
    };

    const readTarget = () => {
      // El alto del escenario (100lvh) no cambia cuando la barra de Safari
      // aparece o se esconde; innerHeight sí, y movería el progreso.
      max = Math.max(1, track.offsetHeight - stage.offsetHeight);
      target = clamp(-track.getBoundingClientRect().top / max);
    };

    // Tono del header mientras dura el zoom ('' = el que ponga HeaderTone).
    const setTone = (next: string) => {
      if (next === tone) return;
      tone = next;
      if (next) root.dataset.toneOverride = next;
      else delete root.dataset.toneOverride;
      dispatchEvent(new Event('tone-override'));
    };

    const render = (p: number) => {
      const u = map(p, T1[0], T1[1], 0, 1);
      const v = map(p, T2[0], T2[1], 0, 1);

      // Hero: el círculo se queda quieto y se agranda; el resto se aleja
      // desde él y se desvanece.
      const isZoomed = u > 0;
      if (isZoomed !== zoomed) {
        zoomed = isZoomed;
        stage.classList.toggle('is-zoomed', isZoomed);
        if (isZoomed) measureDot();
      }
      hero.style.opacity = String(1 - mapSoft(u, 0, 0.55, 0, 1));
      // Crecimiento geométrico (multiplica a ritmo constante): un zoom se
      // percibe parejo desde el primer pixel de scroll. La curva cúbica de
      // antes casi no se movía al principio y se sentía como un freno.
      hero.style.transform = isZoomed ? `scale(${Math.pow(4, u)})` : '';
      const r1 = (dotD / 2) * Math.pow(S1, clamp(u / 0.7));
      // Al guardarse en la "o" (v ≈ 0.9) la tinta se desvanece del todo.
      portalInk.style.opacity = isZoomed ? String(1 - mapSoft(v, 0.88, 1, 0, 1)) : '0';
      if (v === 0) portalInk.style.clipPath = circle(r1, ink);
      // Fondo tinta sólido entre los dos cruces; en el segundo lo reemplaza
      // el círculo de tinta que se encoge (encima de "Para quién").
      bgInk.style.opacity = u >= 0.7 && v === 0 ? '1' : '0';

      // Por qué Galena: entra cuando el círculo ya cubre y sale al cruce 2.
      const whyIn = mapSoft(u, 0.7, 0.97, 0, 1);
      // Al salir, su contenido se encoge hacia el "10" y se desvanece, y la
      // tinta (el mismo círculo del primer cruce, ahora centrado en el "10")
      // se cierra hasta desaparecer.
      const whyOut = 1 - mapSoft(v, 0.05, 0.5, 0, 1);
      why.style.opacity = String(whyIn * whyOut);
      const whyScale = v > 0 ? 1 - 0.45 * soft(clamp(v / 0.9)) : mapSoft(u, 0.7, 1, 0.6, 1);
      why.style.transform = `scale(${whyScale})`;
      // La tinta se cierra hacia el "10" y, al final, se guarda en la "o" del
      // titular: el centro viaja de una a otra y el radio termina siendo el
      // del hueco de la letra (no desaparece).
      const t2 = clamp(v / 0.9);
      const r2 = nest.r + (R2 - nest.r) * Math.pow(1 - t2, 1.6);
      const travel = soft(clamp((t2 - 0.25) / 0.75));
      const c2 = { cx: bone.cx + (nest.cx - bone.cx) * travel, cy: bone.cy + (nest.cy - bone.cy) * travel };
      if (v > 0) portalInk.style.clipPath = circle(r2, c2);
      // El contenido se recorta con el mismo círculo, para que nada asome
      // fuera de la tinta. Su escala parte del "10", así que en sus
      // coordenadas el centro y el radio se dividen entre la escala.
      why.style.clipPath =
        v > 0
          ? circle(r2 / whyScale, {
              cx: bone.cx + (c2.cx - bone.cx) / whyScale,
              cy: bone.cy + (c2.cy - bone.cy) / whyScale,
            })
          : '';
      bgBone.style.opacity = v > 0 ? '1' : '0';

      // Para quién: está debajo de la tinta y aparece mientras se cierra.
      audience.style.opacity = v > 0 ? '1' : '0';
      audience.style.transform = `scale(${mapSoft(v, 0, 1, 0.94, 1)})`;

      // Header en tinta (con el logo en hueso) mientras el fondo es tinta:
      // desde que el círculo del hero llega al header hasta que el círculo
      // hueso lo alcanza.
      // Tinta mientras el círculo cubre la franja del header (al entrar y al
      // salir); antes, plata (la del hero); después, hueso (la de "Para
      // quién", aunque "Por qué Galena" siga debajo del header).
      const covered = v > 0 ? r2 >= need2 : r1 >= 0.9 * need1;
      setTone(isZoomed && covered ? 'ink' : !isZoomed ? '' : v > 0 ? 'bone' : 'silver');

      // Solo la escena que se ve (la de más opacidad, si pasa de la mitad)
      // recibe clics: nunca un botón invisible.
      const levels: [HTMLElement, number][] = [
        [hero, 1 - mapSoft(u, 0, 0.55, 0, 1)],
        [why, whyIn * whyOut],
        [audience, mapSoft(v, 0.3, 0.6, 0, 1)],
      ];
      const top = levels.reduce((a, b) => (b[1] > a[1] ? b : a));
      for (const [scene, level] of levels) {
        scene.style.pointerEvents = scene === top[0] && level >= 0.5 ? 'auto' : 'none';
      }
    };

    const frame = (now: number) => {
      // El factor se ajusta al tiempo real entre cuadros: la inercia es la
      // misma a 60 y a 120Hz.
      const dt = last ? Math.min(now - last, 50) : 16.67;
      last = now;
      current += (target - current) * (1 - Math.pow(1 - EASE, dt / 16.67));
      if (Math.abs(target - current) < 0.0002) {
        current = target;
        raf = 0;
        last = 0;
      } else {
        raf = requestAnimationFrame(frame);
      }
      render(current);
    };

    // El scroll solo marca el objetivo; un único bucle rAF escribe el DOM y
    // se detiene en reposo.
    const onScroll = () => {
      readTarget();
      if (!raf) raf = requestAnimationFrame(frame);
    };

    const remeasure = () => {
      if (!running) return;
      lastW = innerWidth;
      lastH = innerHeight;
      zoomed = false;
      stage.classList.remove('is-zoomed');
      readTarget();
      measureFocal();
      measureNest();
      current = target;
      render(current);
    };

    const onResize = () => {
      // En el teléfono, la barra del navegador cambia el alto al hacer
      // scroll: eso no es un cambio de tamaño real, no se vuelve a medir.
      if (innerWidth === lastW && Math.abs(innerHeight - lastH) < 160) {
        onScroll();
        return;
      }
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        // Al cambiar el tamaño, el scroll se conserva en píxeles pero la
        // pista cambia de alto: se guarda el progreso y se vuelve a él.
        const keep = current;
        remeasure();
        if (!running) return;
        const trackTop = track.getBoundingClientRect().top + scrollY;
        scrollTo({ top: trackTop + keep * max, behavior: 'instant' });
        readTarget();
        current = target;
        render(current);
      }, 150);
    };

    // Con el foco en una escena que no está en su meseta (Tab), el scroll
    // va hasta ella.
    const onFocusIn = (event: FocusEvent) => {
      const scene = (event.target as Element).closest<HTMLElement>('.hero, .why, .audience');
      if (!scene || scene.style.pointerEvents === 'auto') return;
      const key = scene === hero ? 'hero' : scene === why ? 'why' : 'audience';
      const top = track.getBoundingClientRect().top + scrollY;
      scrollTo({ top: top + HOLD[key] * max, behavior: 'instant' });
    };

    const start = () => {
      if (running) return;
      running = true;
      root.dataset.zoom = '';
      remeasure();
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onResize);
      stage.addEventListener('focusin', onFocusIn);
      // Las fuentes cambian las medidas del texto.
      document.fonts?.ready.then(() => running && remeasure());
    };

    const stop = () => {
      if (!running) return;
      running = false;
      clearTimeout(resizeTimer);
      cancelAnimationFrame(raf);
      raf = 0;
      removeEventListener('scroll', onScroll);
      removeEventListener('resize', onResize);
      stage.removeEventListener('focusin', onFocusIn);
      stage.classList.remove('is-zoomed');
      setTone('');
      delete root.dataset.zoom;
      for (const el of [hero, why, audience, portalInk, bgInk, bgBone]) el.removeAttribute('style');
    };

    // Al cambiar el tamaño o la preferencia de movimiento, el efecto se
    // enciende o se apaga sin recargar.
    const sync = () => (mq.matches ? start() : stop());
    mq.addEventListener('change', sync);
    sync();
  }
</script>
