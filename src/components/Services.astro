---
// Servicios principales. Cada tarjeta es un panel con nombre, número y una
// figura de línea (excepción aprobada a "sin ilustraciones": geometría
// abstracta hecha a mano, en --ink), y debajo, separada, su descripción.
// Las figuras se trazan al entrar (Reveal), se mueven lento y reaccionan al
// mouse; todo en CSS (global.css). Informativas: sin enlace.
// En táctil las figuras se mueven mientras la sección está en pantalla: la
// isla de abajo solo marca data-onscreen con un IntersectionObserver.
// Copy en borrador, pendiente de aprobación.
const services = [
  {
    name: 'Sitios web',
    text: 'Modernos, rápidos y con el estilo de tu marca. Pensados para que cada visita termine en un mensaje, una cita o una venta.',
    figure: 'site',
  },
  {
    name: 'Automatizaciones',
    text: 'Correos y mensajes de WhatsApp que se envían solos: confirmaciones, recordatorios y seguimiento, sin que escribas cada uno.',
    figure: 'flow',
  },
  {
    name: 'Gestión de clientes',
    text: 'Todos tus contactos y conversaciones en un solo lugar, con el historial de cada cliente y en qué etapa va.',
    figure: 'venn',
  },
  {
    name: 'Agenda de citas',
    text: 'Tus clientes reservan desde tu sitio en los horarios que tú defines, y tu calendario se actualiza solo.',
    figure: 'calendar',
  },
  {
    name: 'Chat en tu sitio',
    text: 'Un chat que puedes conectar a WhatsApp para responder desde un solo lugar. Y si lo necesitas, un chatbot con inteligencia artificial: incluido en el plan IA Total o como servicio adicional.',
    figure: 'chat',
  },
];
---

<section class="services" id="servicios" aria-labelledby="services-title">
  <div class="section-intro" data-reveal-group>
    <p class="eyebrow">Servicios</p>
    <h2 class="section-title" id="services-title">Nuestra especialidad</h2>
  </div>

  <div class="services__grid" data-reveal-group>
    {
      services.map((service, i) => (
        <article class="service" style={`--i: ${i}`}>
          <div class="service__panel">
            <div class="service__head">
              <h3 class="service__name">{service.name}</h3>
              <span class="service__index">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="service__stage">
              <span class="service__corners" aria-hidden="true" />

            {/* pathLength="1" en cada trazo: el dibujo de entrada anima
                stroke-dashoffset de 1 a 0 sin medir longitudes. */}
            <svg class="service__figure" viewBox="0 0 200 200" aria-hidden="true">
              {service.figure === 'site' && (
                <>
                  <rect x="30" y="45" width="140" height="110" rx="6" pathLength="1" />
                  <path d="M30 65H170" pathLength="1" />
                  <circle cx="42" cy="55" r="3" pathLength="1" />
                  <circle cx="54" cy="55" r="3" pathLength="1" />
                  <g class="service__motion service__motion--float">
                    <rect x="44" y="79" width="52" height="62" rx="3" pathLength="1" />
                    <path d="M108 86H156M108 100H156M108 114H140" pathLength="1" />
                    <rect x="108" y="126" width="32" height="15" rx="7.5" pathLength="1" />
                  </g>
                </>
              )}
              {service.figure === 'flow' && (
                <>
                  <rect x="75" y="28" width="50" height="22" rx="11" pathLength="1" />
                  <path d="M100 50V70" pathLength="1" />
                  <path d="M100 70L122 92L100 114L78 92Z" pathLength="1" />
                  <path d="M78 92H50V128M122 92H150V128" pathLength="1" />
                  <path d="M46 123L50 128L54 123M146 123L150 128L154 123" pathLength="1" />
                  <rect x="28" y="128" width="44" height="28" rx="4" pathLength="1" />
                  <rect x="128" y="128" width="44" height="28" rx="4" pathLength="1" />
                  <circle class="service__motion service__motion--flow" cx="100" cy="50" r="3" />
                </>
              )}
              {service.figure === 'venn' && (
                <g class="service__motion service__motion--spin-slow">
                  <circle cx="100" cy="76" r="42" pathLength="1" />
                  <circle cx="78" cy="114" r="42" pathLength="1" />
                  <circle cx="122" cy="114" r="42" pathLength="1" />
                  <circle cx="100" cy="101" r="3" pathLength="1" />
                </g>
              )}
              {service.figure === 'calendar' && (
                <>
                  <rect x="40" y="45" width="120" height="110" rx="8" pathLength="1" />
                  <path d="M40 72H160" pathLength="1" />
                  <path d="M72 36V54M128 36V54" pathLength="1" />
                  <text class="service__date" x="146" y="142" text-anchor="end">12</text>
                </>
              )}
              {service.figure === 'chat' && (
                <>
                  <rect x="30" y="48" width="100" height="60" rx="16" pathLength="1" />
                  <path d="M52 108L46 122L68 108" pathLength="1" />
                  {/* Cabeza de bot en el globo de la izquierda: el que responde. */}
                  <rect x="64" y="70" width="32" height="22" rx="6" pathLength="1" />
                  <path d="M80 70V63" pathLength="1" />
                  <circle cx="80" cy="61" r="2" pathLength="1" />
                  <g class="service__motion service__motion--blink">
                    <circle class="service__dot" cx="73" cy="81" r="2.5" />
                    <circle class="service__dot" cx="87" cy="81" r="2.5" />
                  </g>
                  <g class="service__motion service__motion--float">
                    <rect x="70" y="98" width="100" height="56" rx="16" pathLength="1" />
                    <path d="M148 154L154 168L132 154" pathLength="1" />
                    <circle cx="104" cy="126" r="3" pathLength="1" />
                    <circle cx="120" cy="126" r="3" pathLength="1" />
                    <circle cx="136" cy="126" r="3" pathLength="1" />
                  </g>
                </>
              )}
              </svg>
            </div>
          </div>
          <p class="service__text">{service.text}</p>
        </article>
      ))
    }
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.services');
  const touch = matchMedia('(hover: none)').matches;

  if (section && touch && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      section.toggleAttribute('data-onscreen', entry.isIntersecting);
    }).observe(section);
  }
</script>
