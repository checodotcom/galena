---
import Layout from '../layouts/Layout.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import Reveal from '../components/Reveal.astro';
import Services from '../components/Services.astro';
import WhyGalena from '../components/WhyGalena.astro';
import Audience from '../components/Audience.astro';
import ClosingCta from '../components/ClosingCta.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import ScrollZoom from '../components/ScrollZoom.astro';

const title = 'Galena — Sitios y automatizaciones para clínicas';
const description =
  'Sitio web, agenda en línea y recordatorios por WhatsApp para que tu clínica llene su agenda y reciba más reseñas.';

// Datos estructurados: solo lo verificable (sin teléfono, reseñas ni redes).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://galena.agency/#organization',
      name: 'Galena',
      url: 'https://galena.agency/',
      logo: 'https://galena.agency/galena-logo-negro.svg',
      email: 'hola@galena.agency',
      description,
      foundingDate: '2026',
      address: { '@type': 'PostalAddress', addressLocality: 'Ciudad de México', addressCountry: 'MX' },
      areaServed: { '@type': 'Country', name: 'México' },
      knowsAbout: [
        'Sitios web',
        'Automatizaciones',
        'Gestión de pacientes (CRM)',
        'Agenda de citas',
        'Chat y chatbots con inteligencia artificial',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://galena.agency/#website',
      url: 'https://galena.agency/',
      name: 'Galena',
      inLanguage: 'es-MX',
      publisher: { '@id': 'https://galena.agency/#organization' },
    },
  ],
};

// Persianas de la transición hueso → plata. El CSS usa 15 en móvil y 10 en
// desktop; se renderizan todas y las sobrantes se ocultan por breakpoint.
const blinds = 15;
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <div class="intro" data-header-tone="clear">
    <!-- Antes que las persianas en el DOM: las barras la tapan al cerrarse. -->
    <svg class="intro__hint" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 9l6 6 6-6"></path>
    </svg>

    <div class="blinds" aria-hidden="true">
      {Array.from({ length: blinds }, (_, i) => <span style={`--i: ${i}`} />)}
    </div>
  </div>

  <!-- Pista del zoom: Hero → Por qué Galena → Para quién (ver ScrollZoom.astro).
       Sin el efecto son tres secciones normales, una tras otra. -->
  <ScrollZoom />
  <div class="zoom">
    <div class="zoom__stage">
      <span class="zoom__bg zoom__bg--ink" aria-hidden="true"></span>
      <span class="zoom__bg zoom__bg--bone" aria-hidden="true"></span>

  <section class="hero" data-header-tone="silver">
    <div class="hero__content">
      <h1 class="hero__title">Tu clínica, atendiendo aunque no estés.</h1>
      <p class="hero__support">
        Sitio web, automatizaciones y agentes que responden, agendan y dan
        seguimiento a tus pacientes por ti.
      </p>
      <div class="hero__actions">
        <a class="plan-cta plan-cta--filled hero__cta cta-shift" href="#servicios">
          <span class="cta-shift__inner">
            <span class="cta-shift__label">Explora nuestros servicios</span>
            <span class="cta-shift__arrow" aria-hidden="true">→</span>
          </span>
        </a>
        <a class="text-link hero__secondary" href="/planes/">Ver planes y precios →</a>
      </div>
    </div>

    <!-- Composición geométrica: las líneas parten la zona derecha en cuatro
         bloques, alternados como tablero (hueso arriba a la derecha y abajo a
         la izquierda). El círculo rebota dentro del bloque de abajo. -->
    <div class="hero__art" aria-hidden="true">
      <span class="hero__block hero__block--top"></span>
      <span class="hero__block hero__block--bottom">
        <span class="hero__orbit"><span class="hero__dot"></span></span>
      </span>
      <span class="hero__vline"></span>
      <span class="hero__hline"></span>
    </div>

  </section>

      <span class="zoom__portal zoom__portal--ink" aria-hidden="true"></span>

      <WhyGalena />

      <Audience />
    </div>
  </div>

  <Services />

  <ProcessTimeline />

  <ClosingCta />

  <About />

  <Faq />

  <Reveal />
</Layout>
