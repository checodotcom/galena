---
// Preguntas frecuentes con <details> nativos: sin JS, y name="faq" hace que
// solo una respuesta esté abierta a la vez. Copy en borrador, pendiente de
// aprobación.
const questions = [
  {
    q: '¿Cuánto tardan en tener listo mi proyecto?',
    a: 'En 10 días hábiles, contados desde el acuerdo y con tu información y accesos en nuestras manos. No necesitas meses de implementación: tu clínica empieza a aprovecharlo cuanto antes.',
  },
  {
    q: '¿Y si no estoy seguro de que sea para mi clínica?',
    a: 'Es normal que se sienta como un riesgo. Cuéntanos qué te frena y buscamos juntos la forma de empezar con menos riesgo.',
  },
  {
    q: '¿Tengo que firmar un contrato forzoso?',
    a: 'No. Pagas mes a mes o por año, y puedes cambiar de plan cuando quieras.',
  },
  {
    q: '¿Necesito saber de tecnología?',
    a: 'No. Configuramos todo por ti y recibes los accesos y lo necesario para operar desde el primer día.',
  },
  {
    q: '¿Qué es la implementación única?',
    a: 'Un pago al inicio que incluye tu sitio web y la configuración inicial. La mensualidad empieza 30 días después, cuando todo ya está funcionando.',
  },
];
---

<section class="faq" aria-labelledby="faq-title">
  <div class="section-intro" data-reveal-group>
    <p class="eyebrow">Preguntas frecuentes</p>
    <h2 class="section-title" id="faq-title">Lo que suelen preguntarnos</h2>
  </div>

  <div class="faq__list" data-reveal-group>
    {
      questions.map((item) => (
        <details class="faq__item" name="faq">
          <summary class="faq__question">
            <span>{item.q}</span>
            <span class="faq__sign" aria-hidden="true" />
          </summary>
          <p class="faq__answer">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
